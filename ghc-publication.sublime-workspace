n    # Remove thumbnail from object storage\n    if self.thumbnail:\n      storage.delete_file(os.path.join('thumbs', os.path.basename(self.thumbnail.name)))\n\n    # Proceed with the default delete operation\n    super().delete(*args, **kwargs)\n\n\n  def save(self, *args, **kwargs):\n    from PIL import Image\n    import os\n    import io\n    from django.utils.text import slugify\n    from django_project import settings\n    from photo_book.utils import extract_number\n    import re\n    from django_project.storage import ReplitObjectStorage\n\n    if not self.image:\n      return\n\n    # Initialize Replit Object Storage\n    storage = ReplitObjectStorage() #claudes object, rewrite someday?\n\n    # Customize filename before saving\n    if self.image:\n      image_namepath = self.image.name\n      print(f\"image_namepath.partition('/')[0]::: {image_namepath.partition('/')[0]}\")\n      if (image_namepath.partition('/')[0] == 'photos'):\n        resave = True #filename is sanitized\n      else: resave = False\n\n      print(f'resave:{resave}')\n\n      ext = os.path.splitext(self.image.name)[1]\n      album_name = slugify(self.album.title) if self.album else \"uncategorized\"\n\n      #check if there is no title\n      if self.title and self.title.strip() != '':\n        # recreate filename from title\n        new_filename = f'{album_name}_{slugify(self.title)}{ext}' \n        print(f\"has title, use title to create file name\\n\")\n      else: #create a new filename from the uploaded file name and album title\n        print(f'has no title, create from filename\\n')\n        print(f\"image_namepath: {image_namepath}\")\n        image_basename = os.path.basename(image_namepath)\n        print(f\"image_basename: {image_basename}\")\n        if '_' in image_basename:\n            based_basename = image_basename.rsplit('_', 1)[1]\n        else:\n            based_basename = image_basename\n        print(f\"based_basename: {based_basename}\")\n\n        # Extract only the first number from the right\n        self.original_filename = re.search(r'\\d+(?!.*\\d)', based_basename).group() if re.search(r'\\d+(?!.*\\d)', based_basename) else ''\n        print(f'self.original_filename: {self.original_filename}')\n\n        bare_basename = os.path.splitext(based_basename)[0] #take filename from path\n        if len(re.sub(r'\\d', '', bare_basename)) > 3:\n            bare_basename = re.sub(r'\\d', '', bare_basename)  # remove all numbers only if result is longer than 3 chars\n        else: print(f'did not remove numbers title too short')\n\n        bare_basename = bare_basename.strip() #leading/trailing spaces\n\n        print(f\"bare_basename: {bare_basename}\\n\")\n\n        new_basename = bare_basename.replace('  ', '').replace('-', ' ') #replace double spaces and dashes\n        print(f\"new_basename: {new_basename}\")\n\n        new_title_name = new_basename.title()\n\n        new_basename = new_basename.replace(' ', '-').replace('_', '-').lower() #replaces remaining dashes with spaces\n        print(f\"new_basename (after:.replace(' ', '-').replace('_', '-').lower()): {new_basename}\\n\")\n\n        new_filename = f\"{album_name}_{new_basename}{ext}\"\n        self.title = new_title_name\n\n        print(f\"\\n\\nnew_filename: {new_filename}\\n\\n\")\n\n      # Save the desired filename\n      self.new_filename = new_filename\n\n      # Get the old image and thumbnail paths\n      try:\n          old_photo = Photo.objects.get(pk=self.pk)\n          old_image_path = old_photo.image.name\n          old_thumb_path = old_photo.thumbnail\n      except Photo.DoesNotExist:\n          old_image_path = None\n          old_thumb_path = None\n\n      # Handle file saving with object storage\n      if hasattr(self.image, 'file'):\n        file_content = self.image.file.read()\n        #self.image.file.seek(0)  # Reset file pointer after reading\n\n        # Set the image field to our exact path\n        image_path = f\"photos/{new_filename}\"\n\n        # Delete old files if the path changed\n        if old_image_path and old_image_path != image_path:\n          print(f\"Deleting old image at path: {old_image_path}\")\n          try:\n            storage.delete_file(old_image_path)\n          except Exception as e:\n            print(f\"Error deleting old image {old_image_path}: {str(e)}\")\n\n        if old_thumb_path:\n          print(f\"Deleting old thumbnail at path: {old_thumb_path}\")\n          try:\n            storage.delete_file(old_thumb_path)\n          except Exception as e:\n            print(f\"Error deleting old thumbnail {old_thumb_path}: {str(e)}\")\n\n        self.image.name = image_path\n\n        # Upload to object storage\n        storage.upload_content(file_content, image_path)\n\n        # Don't let Django process the file again when we call super().save()\n        self.image._committed = True\n\n    # Call parent save\n    super().save(*args, **kwargs)\n\n    # Process the image (make a copy for manipulation)\n    image_data = storage.download_content(self.image.name, as_text=False)\n    img = Image.open(io.BytesIO(image_data))\n\n    # Get EXIF data including date and orientation\n    try:\n      if hasattr(img, '_getexif'):\n        exif = img._getexif()\n        if exif is not None:\n          # Handle orientation\n          orientation = exif.get(274)  # 274 is the orientation tag\n          if orientation == 3:\n            img = img.rotate(180, expand=True)\n          elif orientation == 6:\n            img = img.rotate(270, expand=True)\n          elif orientation == 8:\n            img = img.rotate(90, expand=True)\n\n          # Get date taken - tag 36867 is 'DateTimeOriginal'\n          if 36867 in exif:\n            from datetime import datetime\n            date_str = exif[36867]\n            # Convert EXIF date format (YYYY:MM:DD HH:MM:SS) to Django date\n            self.date_taken = datetime.strptime(date_str, '%Y:%m:%d %H:%M:%S').date()\n    except:\n      pass  # If EXIF processing fails, continue with original image\n\n    # Resize main photo if larger than max dimensions\n    max_size = (1920, 1080)\n    if img.size[0] > max_size[0] or img.size[1] > max_size[1]:\n      img.thumbnail(max_size, Image.LANCZOS)\n\n    # Save processed image to object storage\n    sanitized_name = new_filename\n    processed_path = f\"photos/{sanitized_name}\"\n\n    # Convert PIL image to bytes\n    img_byte_arr = io.BytesIO()\n    img.save(img_byte_arr, format=img.format or 'JPEG', quality=85, optimize=True)\n    img_byte_arr.seek(0)\n\n    # Upload processed image to object storage\n    storage.upload_content(img_byte_arr.getvalue(), processed_path)\n\n    # Create thumbnail\n    thumb_img = img.copy()\n    thumb_size = (200, 200)\n    thumb_img.thumbnail(thumb_size, Image.LANCZOS)\n\n    # Convert thumbnail to bytes\n    thumb_byte_arr = io.BytesIO()\n    thumb_img.save(thumb_byte_arr, format=img.format or 'JPEG', quality=85, optimize=True)\n    thumb_byte_arr.seek(0)\n\n    # Use the clean filename without random strings\n    base_filename = os.path.basename(self.image.name)\n    thumb_filename = f'thumb_{base_filename}'\n    thumb_path = f\"thumbs/{thumb_filename}\"\n\n    # Upload thumbnail to object storage\n    storage.upload_content(thumb_byte_arr.getvalue(), thumb_path)\n\n    # Update thumbnail field - store the relative path for database\n    self.thumbnail = thumb_path\n    super().save(update_fields=['thumbnail', 'date_taken'])\n\n  def __str__(self):\n    return self.title",
